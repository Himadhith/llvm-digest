# Copy to .env (git-ignored) for local runs. On DAM, set these under
# Agent Setup -> Environment, and use Connections for secrets. Never commit real values.

# --- Sources ----------------------------------------------------------------
ENABLE_DISCOURSE=true
DISCOURSE_BASE_URL=https://discourse.llvm.org
ENABLE_GITHUB=true
GITHUB_REPO=llvm/llvm-project
GITHUB_API_URL=https://api.github.com
# Optional (secret). Raises GitHub rate limits; on DAM the gateway injects it instead.
GITHUB_TOKEN=

# --- Destination (secret: the URL itself is the credential) -------------------
# Only needed for standalone posting (`llvm-digest run`). Under DAM the agent posts
# to its bound Slack channel itself and this stays empty.
WEBHOOK_URL=
# slack = Block Kit payload; text = {"text": "<markdown>"} (Teams/Mattermost/generic)
WEBHOOK_FORMAT=slack

# --- Behaviour ----------------------------------------------------------------
STATE_DB_PATH=state/llvm_digest.db
POLL_INTERVAL_MINUTES=60
LOG_LEVEL=INFO
LOOKBACK_HOURS=48
MAX_PAGES=3
MAX_ITEMS_PER_RUN=10

# --- HTTP safeguards ----------------------------------------------------------
REQUEST_TIMEOUT_S=15
MAX_RETRIES=4
MIN_REQUEST_INTERVAL_S=0.5
WEBHOOK_MIN_INTERVAL_S=1.2

# --- Summarizer (standalone mode) ---------------------------------------------
# extractive = no LLM needed; llm = OpenAI-compatible /chat/completions.
# Under DAM the agent's own model writes the summaries (see CLAUDE.md).
SUMMARIZER=extractive
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Optional classification overrides (comma-separated Discourse category ids) --
# SANITIZER_CATEGORY_IDS=12,73
# CLANG_CATEGORY_IDS=6,47,48,49,113
# LLC_CATEGORY_IDS=51,52,53,54,55,56,57,58,59,38
# EXCLUDED_CATEGORY_IDS=75,76,16,69,37,44,46
# BODY_SCAN_CATEGORY_IDS=5,1,61,17,64
# EXCLUDED_TAGS=llvm-weekly
